{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Match",
  "description": "Schema canonico para o registro de partidas no Jornada Dashboard",
  "type": "object",
  "required": [
    "id",
    "Data",
    "Player",
    "Adversario",
    "Deck",
    "DeckAdv",
    "Placar",
    "Formato"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "Data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Player": {
      "type": "string",
      "minLength": 1
    },
    "Adversario": {
      "type": "string",
      "minLength": 1
    },
    "Deck": {
      "type": "string",
      "minLength": 1
    },
    "DeckAdv": {
      "type": "string",
      "minLength": 1
    },
    "Placar": {
      "type": "string",
      "pattern": "^\\d+x\\d+$"
    },
    "Formato": {
      "type": "string",
      "enum": [
        "MD3",
        "MD1"
      ]
    },
    "Resultado": {
      "type": "string",
      "enum": [
        "Vitória",
        "Derrota",
        "Empate"
      ]
    },
    "seqID": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "Subtipo": {
      "type": "string"
    },
    "SubtipoAdv": {
      "type": "string"
    },
    "Brick": {
      "type": "boolean"
    },
    "BrickOp": {
      "type": "boolean"
    },
    "Confiabilidade": {
      "type": "string",
      "enum": [
        "Alta",
        "Baixa"
      ]
    },
    "Local": {
      "type": "string"
    },
    "Colecao": {
      "type": "string"
    },
    "Comentarios": {
      "type": "string"
    }
  }
}