{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TournamentMetaSummary",
  "type": "object",
  "required": [
    "date",
    "timezone",
    "minPlayersFilter",
    "totalTournaments",
    "totalPlayers",
    "topDecks",
    "other",
    "champions",
    "tournaments"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "displayDate": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "minPlayersFilter": {
      "type": "integer"
    },
    "totalTournaments": {
      "type": "integer",
      "minimum": 0
    },
    "totalPlayers": {
      "type": "integer",
      "minimum": 0
    },
    "topDecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "players", "metaShare", "wins", "icons"],
        "properties": {
          "name": { "type": "string" },
          "players": { "type": "integer", "minimum": 1 },
          "metaShare": { "type": "number", "minimum": 0, "maximum": 100 },
          "wins": { "type": "integer", "minimum": 0 },
          "icons": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "other": {
      "type": "object",
      "required": ["players", "metaShare"],
      "properties": {
        "players": { "type": "integer", "minimum": 0 },
        "metaShare": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "champions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tournament", "tournamentId", "players", "player", "deck"],
        "properties": {
          "tournament": { "type": "string" },
          "tournamentId": { "type": "string" },
          "tournamentUrl": { "type": "string" },
          "players": { "type": "integer" },
          "player": { "type": "string" },
          "deck": { "type": "string" },
          "icons": { "type": "array", "items": { "type": "string" } },
          "decklistUrl": { "type": ["string", "null"] }
        }
      }
    },
    "tournaments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "organizer", "players", "url"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "organizer": { "type": "string" },
          "players": { "type": "integer" },
          "dateUtc": { "type": "string" },
          "dateSpDay": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "cached": { "type": "boolean" },
    "generatedAt": { "type": "string" }
  }
}
