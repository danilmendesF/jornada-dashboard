# 🔐 JORNADA DASHBOARD — ENVIRONMENT VARIABLES EXAMPLE
# Rename this file to .env or .env.local for local development.
# DO NOT COMMIT REAL SECRETS TO GITHUB.

# JWT Secret Key for user session signing (HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_here

# Redis KV connection URL for serverless cloud sync
REDIS_URL=redis://default:your_redis_password@your_redis_host:6379
